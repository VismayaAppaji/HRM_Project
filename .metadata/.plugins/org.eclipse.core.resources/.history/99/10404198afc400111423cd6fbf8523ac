package com.example.demo.payslip.serviceimpl;

import java.io.ByteArrayOutputStream;
import java.util.UUID;

import org.springframework.stereotype.Service;

import com.example.demo.payslip.service.PayslipService;
import com.example.demo.payroll.entity.Payroll;
import com.example.demo.payroll.repository.PayrollRepository;
import com.lowagie.text.Document;
import com.lowagie.text.Paragraph;
import com.lowagie.text.Table;
import com.lowagie.text.pdf.PdfWriter;

@Service
public class PayrollServiceImpl implements PayslipService {

    private final PayrollRepository payrollRepository;

    public PayrollServiceImpl(
            PayrollRepository payrollRepository) {

        this.payrollRepository = payrollRepository;
    }

    @Override
    public byte[] generatePayslipPdf(UUID payrollId) {

        Payroll payroll = payrollRepository.findById(payrollId)
                .orElseThrow(() ->
                        new RuntimeException("Payroll not found"));

        try {

            ByteArrayOutputStream outputStream =
                    new ByteArrayOutputStream();

            Document document = new Document();

            PdfWriter.getInstance(document, outputStream);

            document.open();

            // Title
            document.add(
                    new Paragraph("HRM PAYSLIP"));

            document.add(
                    new Paragraph(
                            "Pay Period: "
                                    + payroll.getPayPeriod()));

            document.add(
                    new Paragraph(
                            "Employee ID: "
                                    + payroll.getEmployeeId()));

            document.add(
                    new Paragraph(" "));

            // Earnings
            document.add(
                    new Paragraph("EARNINGS"));

            Table earningsTable =
                    new Table(2);

            earningsTable.addCell("Basic Salary");
            earningsTable.addCell(
                    payroll.getBasicSalary().toString());

            earningsTable.addCell("HRA");
            earningsTable.addCell(
                    payroll.getHra().toString());

            earningsTable.addCell("Special Allowance");
            earningsTable.addCell(
                    payroll.getSpecialAllowance().toString());

            earningsTable.addCell("Gross Salary");
            earningsTable.addCell(
                    payroll.getGrossSalary().toString());

            document.add(earningsTable);

            document.add(
                    new Paragraph(" "));

            // Deductions
            document.add(
                    new Paragraph("DEDUCTIONS"));

            Table deductionTable =
                    new Table(2);

            deductionTable.addCell("PF");
            deductionTable.addCell(
                    payroll.getPf().toString());

            deductionTable.addCell("ESI");
            deductionTable.addCell(
                    payroll.getEsi().toString());

            deductionTable.addCell("Professional Tax");
            deductionTable.addCell(
                    payroll.getProfessionalTax().toString());

            deductionTable.addCell("Total Deductions");
            deductionTable.addCell(
                    payroll.getTotalDeductions().toString());

            document.add(deductionTable);

            document.add(
                    new Paragraph(" "));

            // Leave Balance
            document.add(
                    new Paragraph("LEAVE BALANCE"));

            Table leaveTable =
                    new Table(2);

            leaveTable.addCell("Casual Leave");
            leaveTable.addCell(
                    payroll.getCasualLeaveBalance().toString());

            leaveTable.addCell("Sick Leave");
            leaveTable.addCell(
                    payroll.getSickLeaveBalance().toString());

            leaveTable.addCell("Earned Leave");
            leaveTable.addCell(
                    payroll.getEarnedLeaveBalance().toString());

            document.add(leaveTable);

            document.add(
                    new Paragraph(" "));

            // Net Salary
            document.add(
                    new Paragraph(
                            "NET SALARY: ₹"
                                    + payroll.getNetSalary()));

            document.close();

            return outputStream.toByteArray();

        } catch (Exception e) {

            throw new RuntimeException(
                    "Failed to generate payslip PDF", e);
        }
    }
}